   그래서 맵마다 "어떤 무기가 유리한가"를 note 에 적어 두었다. 밸런싱은 이 note 를 기준으로 한다.

   base   : 지표 평균 높이 (0=꼭대기, 1=바닥)
   gravity: px/s². 표준 540
   wind   : 매 턴 재추첨되는 바람 세기의 최대 절댓값
   voidY  : 이 y 를 넘어가면 낙사. 보통 h 지만 용암 맵은 더 위 */
(function (root) {
  'use strict';

  var MAPS = [
    {
      id: 'ridge', name: '초원 능선', note: '표준 전장. 모든 무기가 설계값대로 동작한다. 사거리 감을 잡는 곳.',
      w: 2200, h: 900, base: 0.62, gravity: 540, wind: 5, settle: true,
      sky: ['#1B2E4A', '#3E6E8C', '#8FB6C0'],
      pal: { 1: '#5C8A3A', 2: '#6B5436', 3: '#4A3B27', 4: '#2A2018' },

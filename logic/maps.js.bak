    },
    {
      id: 'undercave', name: '지하 공동', note: '천장이 있다. 고각 곡사가 자기 머리 위 천장에 막힌다. 직사·돌파탄의 무대.',
      w: 2200, h: 1000, base: 0.74, gravity: 560, wind: 3, settle: false, spawnScanY: 0.50,
      // 지하에서 "하늘"은 빈 공간이다. 아래로 갈수록 밝아지면 암반 바닥과 값이 붙어 형태가 안 읽힌다.
      sky: ['#04060A', '#070A10', '#0B1017'],
      pal: { 1: '#7C8899', 2: '#525C6C', 3: '#39414E', 4: '#1C2027' },
      ground: [{ amp: 55, freq: 5 }, { amp: 18, freq: 12 }],
      ops: [

    },
    {
      id: 'mesa', name: '건조 대지', note: '계단식 평지. 사거리 싸움. 이동 연료를 아껴 고지대를 선점하는 쪽이 유리하다.',
      w: 2600, h: 900, base: 0.68, gravity: 520, wind: 7, settle: true,
      sky: ['#3A2416', '#8A5A2E', '#D9A45E'],
      pal: { 1: '#C89A54', 2: '#A87038', 3: '#6E4522', 4: '#3A2614' },

      w: 2400, h: 950, base: 0.55, gravity: 560, wind: 6, settle: true,
      sky: ['#2A1B2E', '#6B3F52', '#C08A6A'],
      pal: { 1: '#8A6A3A', 2: '#7A4E32', 3: '#4E2F22', 4: '#2A1A14' },
      ground: [{ amp: 60, freq: 4 }, { amp: 26, freq: 11 }],

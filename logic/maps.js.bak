      ],
      spawn: [[0.05, 0.12], [0.88, 0.95], [0.38, 0.45], [0.55, 0.62]]
    },
    {
      id: 'glacier', name: '빙하 균열', note: '좁은 크레바스가 여럿. 한 발 빗나가면 그 자리가 곧 무덤이 된다.',
      w: 2500, h: 920, base: 0.60, gravity: 500, wind: 9, settle: true,
      sky: ['#16283A', '#3C6E8E', '#BFE0EA'],
      pal: { 1: '#DCEAF2', 2: '#9EBACC', 3: '#5C7E96', 4: '#33475A' },
      ground: [{ amp: 70, freq: 6 }, { amp: 24, freq: 15 }],
      ops: [
        { op: 'gap', x0: 700, x1: 800, taper: 40 },
        { op: 'gap', x0: 1220, x1: 1330, taper: 44 },
        { op: 'gap', x0: 1740, x1: 1830, taper: 40 }
      ],
      spawn: [[0.06, 0.24], [0.78, 0.94], [0.34, 0.46], [0.56, 0.66]]
    },
    {
      id: 'caldera', name: '분화구', note: '중력이 무겁고 지형이 그릇이다. 사거리가 짧아지고 근접 난전이 된다.',
      w: 2000, h: 900, base: 0.80, gravity: 640, wind: 4, settle: true,
      sky: ['#2A0F10', '#6E2418', '#C6603A'],
